{
  "name": "clinic-instagram-automation-mvp",
  "version": "0.1.0",
  "description": "MVP for automated Instagram publishing flow via Telegram bot for a medical clinic",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test:env": "tsx src/scripts/test-env.ts",
    "test:db": "tsx src/scripts/test-db.ts",
    "test:content-workflow-db": "tsx src/scripts/test-content-workflow-db.ts",
    "test:storage": "tsx src/scripts/test-storage.ts",
    "test:instagram": "tsx src/scripts/test-instagram.ts",
    "test:instagram-publish": "tsx src/scripts/test-instagram-publish.ts",
    "test:telegram": "tsx src/scripts/test-telegram.ts",
    "test:media-design": "tsx src/scripts/test-media-design.ts",
    "test:media-design-latest": "tsx src/scripts/test-media-design-latest.ts",
    "test:text-poster-design": "tsx src/scripts/test-text-poster-design.ts",
    "test:text-poster-flow": "tsx src/scripts/test-text-poster-flow.ts",
    "test:design-variants": "tsx src/scripts/test-design-variants.ts",
    "test:caption-format": "tsx src/scripts/test-caption-format.ts",
    "test:assistant": "tsx src/scripts/test-assistant.ts",
    "debug:instagram-access": "tsx src/scripts/debug-instagram-access.ts"
  },
  "keywords": [
    "telegram",
    "instagram",
    "openai",
    "medical",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "better-sqlite3": "^11.10.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.6.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-cron": "^3.0.3",
    "openai": "^4.104.0",
    "sharp": "^0.34.5",
    "telegraf": "^4.16.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.13.8",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
