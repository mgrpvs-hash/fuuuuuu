NODE_ENV=development
PORT=3000
LOG_LEVEL=info

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_MODE=webhook
TELEGRAM_WEBHOOK_DOMAIN=https://your-public-domain.com
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET_TOKEN=your_telegram_webhook_secret

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=30000

# SQLite for MVP / early production
DATABASE_URL=./data/app.db

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_GRAPH_API_BASE=https://graph.facebook.com/v20.0
INSTAGRAM_REQUEST_TIMEOUT_MS=30000
INSTAGRAM_RETRY_ATTEMPTS=4
INSTAGRAM_RETRY_MIN_DELAY_MS=700
INSTAGRAM_RETRY_MAX_DELAY_MS=8000
MEDIA_PUBLIC_BASE_URL=https://your-public-media-host

DEFAULT_TONE=professional
DEFAULT_LANGUAGE=ru
TIMEZONE=Europe/Moscow

# Platform protection
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
MAX_MEDIA_FILE_SIZE_MB=50
MAX_VIDEO_DURATION_SECONDS=300
